{
  "name": "gastropub",
  "productName": "Gastropub",
  "version": "0.1.0",
  "description": "A delicious EPUB and PDF reader for Windows",
  "author": "Josh Feldman",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshfeld/gastropub.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "audit": "npm audit --audit-level=high",
    "dist": "node scripts/copy-vendor.mjs && electron-builder --win --publish never",
    "release": "node scripts/copy-vendor.mjs && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.joshfeld.gastropub",
    "productName": "Gastropub",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB Book",
        "description": "EPUB e-book",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "joshfeld",
        "repo": "gastropub",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "foliate-js": "1.0.1",
    "pdfjs-dist": "6.4.299"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
